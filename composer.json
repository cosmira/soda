{
    "name": "cosmira/soda",
    "description": "Keep your PHP code clean and maintainable by enforcing quality rules based on metrics",
    "keywords": [
        "php",
        "code-quality",
        "metrics",
        "architecture",
        "static-analysis",
        "ci",
        "developer-tools"
    ],
    "homepage": "https://github.com/cosmira/soda",
    "license": "MIT",
    "authors": [
        {
            "name": "Alexandr Chernyaev",
            "email": "bliz48rus@gmail.com",
            "role": "lead"
        }
    ],
    "support": {
        "issues": "https://github.com/cosmira/soda/issues"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "prefer-stable": true,
    "require": {
        "php": ">=8.2",
        "illuminate/console": "^11.0||^12.0||^13.0",
        "illuminate/container": "^11.0||^12.0||^13.0",
        "illuminate/events": "^11.0||^12.0||^13.0",
        "illuminate/support": "^11.0||^12.0||^13.0",
        "laravel/prompts": "^0.1.15||^0.2.0||^0.3.0",
        "nikic/php-parser": "^5.0",
        "phplrt/parser": "^4.2.4",
        "phplrt/source": "^4.2.4",
        "phpunit/php-file-iterator": "^5.1||^6.0||^7.0",
        "sebastian/complexity": "^4.0||^5.0||^6.0"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.1",
        "infection/infection": "^0.32.6||^0.35.8",
        "laravel/pint": "^1.28",
        "phplrt/compiler": "^4.2.4",
        "phplrt/lexer-builder": "^4.2.4",
        "phplrt/parser-builder": "^4.2.4",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^11.5||^12.0||^13.0",
        "rector/rector": "^2.3"
    },
    "scripts": {
        "test": "phpunit --exclude-group performance --fail-on-deprecation --display-deprecations",
        "test:performance": "php -d memory_limit=256M vendor/bin/phpunit --group performance",
        "test:unit": "phpunit --testsuite unit",
        "test:e2e": "phpunit --testsuite end-to-end",
        "quality": "@php soda quality",
        "pint": "pint  --quiet",
        "phpstan": "phpstan analyse src --no-progress --memory-limit=512M",
        "rector": "rector process src --no-progress-bar",
        "ci": [
            "composer dump-autoload --optimize --strict-psr",
            "@pint:test",
            "@phpstan",
            "@rector:check",
            "@quality",
            "@test",
            "@test:performance"
        ],
        "rules:compile": "phplrt compile resources/rules.pp3 resources/rules.php --php=8.2",
        "pint:test": "pint --test",
        "rector:check": "rector process src --dry-run --no-progress-bar"
    },
    "autoload": {
        "psr-4": {
            "Cosmira\\Soda\\": "src/"
        }
    },
    "autoload-dev": {
        "classmap": [
            "tests/"
        ]
    },
    "bin": [
        "soda"
    ],
    "extra": {
        "branch-alias": {
            "dev-master": "1.1-dev"
        }
    }
}
